# Heirloom environment. Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# ---- Mode & chain (public) ----
# "mock" (default: in-memory demo data, offline) or "chain" (Solana via the Anchor client + WDK signing)
NEXT_PUBLIC_DATA_MODE=mock
# devnet | mainnet-beta | testnet | localnet
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
# Optional custom RPC (defaults to the public endpoint for the cluster). Also added to the CSP connect-src.
NEXT_PUBLIC_SOLANA_RPC_URL=
# Deployed Heirloom program id (overrides the address in src/lib/chain/idl/heirloom.json)
NEXT_PUBLIC_HEIRLOOM_PROGRAM_ID=b3PBVwkLnyx7eyLPNtc5J3Ds3os3cenqCVRHaCJM7FY
# USD₮ mint the estates use. Devnet: our 6-decimal test mint from scripts/devnet-setup.ts.
# Mainnet USD₮: Es9vMFrzaCERmJfrF4H2FYD4KCoNkY11McCe8BenwNYB
NEXT_PUBLIC_USDT_MINT=
# Demo only: override the will's waiting period after death is confirmed (seconds), e.g. 60
NEXT_PUBLIC_DEMO_WAITING_SECS=60
# Demo only: interval for every scheduled (recurring) payment in seconds, e.g. 60. Empty = real intervals.
NEXT_PUBLIC_DEMO_INTERVAL_SECS=60

# ---- Server only (never NEXT_PUBLIC) ----
# Optional server-side RPC for the agent wallet (defaults to NEXT_PUBLIC_SOLANA_RPC_URL / cluster default)
SOLANA_RPC_URL=
# The AI agent's Tether WDK wallet (12/24-word BIP-39). Signs only review_*, list_asset, accept_offer.
AGENT_SEED_PHRASE=

# Google Gemini (AI agent). Without a key the agent returns clearly-labelled canned answers.
GEMINI_API_KEY=
# Default: gemini-4-argon (stable; PDF/image input, structured output, function calling, Search grounding)
GEMINI_MODEL=gemini-4-argon

# Supabase (off-chain metadata + private `evidence` bucket). Without these, an in-memory store is used.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs voice agent. Without these, voice reports "unavailable" and the UI uses text chat.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Shared secret the ElevenLabs server tool sends as header x-heirloom-tool-secret to /api/agent/orchestrate
ELEVENLABS_TOOL_SECRET=

# Scheduled payments: POST /api/scheduler/tick needs header x-heirloom-scheduler-secret: $SCHEDULER_SECRET
# (scripts/run-scheduler.ts calls it every 20 s in the demo). CRON_SECRET is accepted as Vercel Cron's Bearer token.
SCHEDULER_SECRET=
CRON_SECRET=

# FX fallback (USD₮→ZAR) when the VALR public ticker is unreachable
FX_FALLBACK_USDT_ZAR=17.5

# ---- Fee sponsorship (families need no SOL): the agent's WDK wallet (AGENT_SEED_PHRASE) is fee payer ----
# POST /api/sponsor validates (lib/sponsor/policy.ts), simulates and co-signs. All optional:
# SPONSOR_ENABLED=0 turns it off (default on when AGENT_SEED_PHRASE is set)
SPONSOR_ENABLED=
# Max network fee per sponsored tx (lamports, default 20000)
SPONSOR_MAX_FEE_LAMPORTS=
# 1 (default) = sponsor pays rent (~0.002 SOL) for a recipient's new USD₮ account; 0 = sender pays
SPONSOR_PAYS_RENT=
# Fees + rent the sponsor may spend per server instance per day (default 500000000 = 0.5 SOL)
SPONSOR_DAILY_BUDGET_LAMPORTS=
# Stop sponsoring below this sponsor balance (default 20000000 = 0.02 SOL)
SPONSOR_MIN_BALANCE_LAMPORTS=

# Hosting: app/vercel.json pins functions to cpt1 (Cape Town; Hobby allows one region) and runs a Vercel Cron
# at 06:00 UTC daily on /api/scheduler/tick (Hobby minimum = once per day, fires within the hour). Vercel sends
# Authorization: Bearer $CRON_SECRET when CRON_SECRET is set in the project. Faster demo ticks: scripts/run-scheduler.ts.
